{
  "name": "aylesim-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint .",
    "test": "tsx --test tests/*.test.ts",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "graph:update": "code-review-graph update",
    "graph:status": "code-review-graph status",
    "graph:changes": "code-review-graph detect-changes --brief",
    "prepare": "husky",
    "verify:handoff": "tsx scripts/verify-handoff.mts",
    "media:compress": "node scripts/compress-images.mjs"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gray-matter": "^4.0.3",
    "gsap": "^3.14.2",
    "next": "^16.2.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.6",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "sharp": "0.34.5",
    "tailwindcss": "^4",
    "tsx": "^4.20.3",
    "typescript": "^5",
    "ultracite": "^6.3.4"
  }
}
